        "type": "CUSTOM_CODE",
        "customCode": {
          "inlineCode": "var text=\"#{text}\"\n\nvar placeholders=JSON.parse(\"#{jsonHolder}\")\n\n\nfunction replacePlaceholder(str, placeHolder, newValue) {\n    const re = new RegExp(`\\{\\{[ ]*${placeHolder}[ ]*\\}\\}`)\n    return str.replace(re, newValue)\n}\n\nconst re = new RegExp(/\\{{[ ]*(?<value>[A-Za-z0-9_]+)[ ]*\\}}/, \"g\")\n\nfor (const match of text.matchAll(re)) {\n    const placeHolder = match.groups.value\n    if (placeHolder && placeholders.hasOwnProperty(placeHolder)) {\n        text = replacePlaceholder(text, placeHolder, placeholders[placeHolder])\n    }\n}\n\nconsole.log(text)",
