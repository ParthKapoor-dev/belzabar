    {
      "id": "43d10adb6f04b08a4f438b735d5ca6ad    ",
      "automationAPIId": "15805db3-0a4f-4f2a-80d8-c433a1ffeced",
      "serviceName": "db_service",
      "methodName": "data.read",
      "coreMethod": false,
      "description": "Fetch school details, school stats, userEmails (having access to this school) using a query (Formulate below as a valid query). Apply the school.id filter to the stats query, if &lt;schoolId&gt; is provided.",
      "inputs": [
        {
          "uuid": "8d49cef8-1a21-4214-9ebd-20e7174fec0c",
          "key": "body",
          "name": "",
          "type": "OBJECT",
          "displayWidgetSuggestion": "OBJECT",
          "combineInput": false,
          "properties": [
            {
              "uuid": "529f4d30-4692-46b3-b1fb-0fea77c68683",
              "value": "SELECT stats.*,\n(\n    SELECT \n        json_agg(u.contact_info->'email'->'primary'->>'id')\n    FROM users u \n    INNER JOIN user_roles ur on ur.user_id = u.id \n    WHERE  jsonb_typeof(ur.user_access->'sendingSchools') = 'array' AND EXISTS \n    (\n        SELECT 1\n        FROM jsonb_array_elements(ur.user_access->'sendingSchools') as ele\n        WHERE ( COALESCE(ele->>'id',NULL)::UUID = COALESCE(stats.school_id, NULL)::UUID OR ele->>'code' = '*')\n    )\n    AND jsonb_typeof(ur.roles) = 'array' AND EXISTS\n    (\n        SELECT 1 \n        FROM jsonb_array_elements(ur.roles) as ele2 \n        JOIN roles ro ON ro.id = COALESCE(ele2->>'id' , NULL)::UUID\n        WHERE ro.role_type = 'OTHERS'\n    )\n) user_emails\nFROM\n(\n    SELECT sub.school_id, sub.school_name, sub.facilities_user_name, to_char(now(),'MM-dd-yyyy') as \"today_date\",\n    count(CASE WHEN (today=1 AND needs_special_review=1) THEN 1 ELSE 0 END) today_special_reviews, \n    count(needs_special_review) total_special_reviews\n    FROM \n    (\n        SELECT s2.current_school_id AS school_id,(u.name->>'firstName') || ' ' || (u.name->>'lastName') AS facilities_user_name, s3.name AS school_name, asm.account_id, \n            (CASE WHEN (asm.details->'profileReview'->>'submittedAt')::timestamp > ( '#{statsDate}'):: timestamp THEN 1 ELSE 0 END) today, \n            (CASE WHEN EXISTS (SELECT 1 FROM approval WHERE (student_id=asm.student_id or account_id=asm.account_id) AND details->>'needsSpecialReview' = 'true') THEN 1 ELSE 0 END) needs_special_review\n        FROM account_student_mapping asm\n        INNER JOIN users u ON u.id = asm.account_id \n        INNER JOIN student s2 ON s2.id = asm.student_id \n        INNER JOIN school s3 ON s3.id = s2.current_school_id \n        WHERE asm.is_primary=true \n    AND (asm.details->'profileReview'->>'submittedAt')::timestamp > '#{lastReviewClosingDate}':: timestamp) sub \n    GROUP BY sub.school_id, sub.school_name,sub.facilities_user_name\n) stats where stats.school_id = COALESCE(NULLIF('#{schoolId}' , 'null')::uuid , stats.school_id)",
              "key": "queryString",
              "name": "SQLQuery",
              "type": "STRING",
              "displayWidgetSuggestion": "CUSTOM",
              "combineInput": true,
              "properties": [],
              "encodingType": "NONE"
