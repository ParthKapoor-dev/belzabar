        },
        "type": "CUSTOM_CODE",
        "customCode": {
          "inlineCode": "// Input roles array \nconst roles = JSON.Parse(\"#{roles}\");\n\n// Initialize empty arrays for recipients and permissions\nlet rolesDetail = {\"recipients\":[], \"permissions\":[]};\n\n// Iterate over each role in the roles array\nroles.forEach(role => {\n\n  // Extract the id from the role's details\n  const actorId = role.details.external.id;\n  \n  // Add to recipients { \"actorType\" :\"GROUP\", \"actorId\":\"<element.details->'external'->>'id'>\" }\n  rolesDetail.recipients.push({\n    \"actorType\": \"GROUP\",\n    \"actorId\": actorId\n  });\n\n  // Add to permissions {\"actorType\" : \"GROUP\", \"actorId\" :\"<element.details->’external’->>’id’>\", \"permissionType\" : \"EDIT\"}\n  rolesDetail.permissions.push({\n    \"actorType\": \"GROUP\",\n    \"actorId\": actorId,\n    \"permissionType\": \"EDIT\"\n  });\n});\n\n// Output the results\nconsole.log(JSON.stringify(rolesDetail));",
          "language": "JAVASCRIPT",
          "executor": "CODE_LAMBDA",
          "fileName": "",
          "file": ""
        },
        "databaseRead": {
          "query": null,
          "account": "null"
        }
      },
