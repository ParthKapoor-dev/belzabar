            "value": "{\"value\":\"<div><div style=\\\\\\\"width:85vw;padding-top:20px;padding-left:50px;border:2px dotted #dadada;margin:auto\\\\\\\"><div style=\\\\\\\"width:100%;height:125px;display:flex;flex-direction:row;align-items:center\\\\\\\"><div style=\\\\\\\"height:90%;width:35%\\\\\\\"><img src=\\\\\\\"https://assets-dev-acme.qa.expertly.example/parent-dashboard-student-enrollment_1.png\\\\\\\" style=\\\\\\\"width:100%;height:100%;object-fit:contain\\\\\\\"></div><div style=\\\\\\\"height:50%;border-right:2px solid #dadada;margin:0 50px 0 50px\\\\\\\"></div><div style=\\\\\\\"height:50%;width:25%\\\\\\\"><img src=\\\\\\\"https://assets-dev-acme.qa.expertly.example/springfield-city-public-schools_1.png\\\\\\\" style=\\\\\\\"width:100%;height:100%;object-fit:contain\\\\\\\"></div></div><div style=\\\\\\\"width:90%;height:auto;margin-top:50px\\\\\\\"><p style=\\\\\\\"font-size:1.5rem;text-transform:capitalize\\\\\\\">Dear Enrollment Official,</p><p style=\\\\\\\"font-size:1.5rem\\\\\\\">The following student has been granted a transfer by the Office of Enrollment, Choice, and Transfers. This change is reflected in ACME and will update in Infinite Campus on the next business day. </p><p style=\\\\\\\"font-size:1.5rem\\\\\\\">Student ID: {{studentId}}></p><p style=\\\\\\\"font-size:1.5rem\\\\\\\">Student Name: {{studentRef}}</p><p style=\\\\\\\"font-size:1.5rem\\\\\\\">Grade: {{studentGrade}}</p><p style=\\\\\\\"font-size:1.5rem\\\\\\\">Exiting School: {{currentSchoolCode}}</p><p style=\\\\\\\"font-size:1.5rem\\\\\\\">Entering School: {{newSchoolCode}}</p><p style=\\\\\\\"font-size:1.5rem\\\\\\\">\\nSincerely,</p><p style=\\\\\\\"font-size:1.5rem\\\\\\\">The ACME Team</p><p style=\\\\\\\"font-size:1.2rem;color:#7d7779\\\\\\\">Student Enrollment Management System (ACME) is a project of Springfield City Public Schools. For information on ACME, contact us at <a style=\\\\\\\"color:#487fa7;text-decoration:underline\\\\\\\" href=\\\\\\\"user@example.com.\\\\\\\">user@example.com.</a></p><p style=\\\\\\\"font-size:1.2rem;color:#7d7779\\\\\\\">&copy; 2023 Springfield City Public Schools<br>200 East North Avenue, Springfield, MD, 21202<br><a href=\\\\\\\"www.springfieldcityschools.example\\\\\\\" style=\\\\\\\"color:#487fa7;text-decoration:underline\\\\\\\">www.springfieldcityschools.example</a><br></p></div></div></div>\"}"
          },
          {
            "id": "483864c0a8aac60bf33b84bfb5680172",
            "createdOn": 1780583884156,
            "testCaseId": "4b89781dfffabf8d4306b4fab1f51e52",
            "fieldCode": "subject",
            "value": "{\"value\": \"City Schools: Your Transfer Request Status\"}"
          },
          {
            "id": "4e78a9f3049ac60162f796f9fa2aa5ce",
            "createdOn": 1780583884161,
            "testCaseId": "4b89781dfffabf8d4306b4fab1f51e52",
            "fieldCode": "id",
            "value": "{\"value\": null}"
          },
          {
            "id": "480654bf4dafc6bbe9278055034ddc27",
            "createdOn": 1780583884162,
            "testCaseId": "4b89781dfffabf8d4306b4fab1f51e52",
            "fieldCode": "templateDataConfig",
            "value": "{\"value\": \"{\\\"recipientsDataQuery\\\":\\\"WITH appr AS (SELECT sch.id AS ofr_sch FROM application a JOIN offer_response ofr ON a.id=ofr.application_id AND a.id={{applicationId}} AND ofr.is_displaying=true JOIN program p ON ofr.program_id=p.id JOIN school sch ON p.school_id=sch.id WHERE EXISTS (SELECT 1 FROM application a1 JOIN users u ON u.id=(a1.details->>''submittedBy'')::uuid AND u.user_type=''PUBLIC'' AND a1.id=a.id)) SELECT json_build_object(user_email, ''{}''::jsonb ) FROM (SELECT user_email, rs->>''code'' AS r_code, (rs->>''id'')::text AS r_id FROM (SELECT u.contact_info->''email''->''primary''->>''id'' user_email, jsonb_array_elements(user_access -> ''receivingSchools'') as rs FROM user_roles usr JOIN users u ON usr.user_id=u.id) AS ur1) AS ur2 WHERE r_code=''*'' OR r_id=(SELECT ofr_sch FROM appr)\\\",\\\"dataQueries\\\":\\\"SELECT cn.display_name AS \\\\\\\"studentGrade\\\\\\\", COALESCE(alternate_ids->''external''->>''id'', alternate_ids->''internal''->>''customId'') AS \\\\\\\"studentId\\\\\\\", concat_ws('' '', s.name->>''firstName'', s.name->>''middleName'', s.name->>''lastName'', s.name->>''suffix'') AS \\\\\\\"studentRef\\\\\\\", csch.code AS \\\\\\\"currentSchoolCode\\\\\\\", nsch.code AS \\\\\\\"newSchoolCode\\\\\\\" FROM application a JOIN account_student_mapping asm ON a.student_id=asm.student_id AND asm.user_permissions->''roles'' ? ''OWNER'' JOIN users u ON asm.account_id=u.id JOIN student s ON a.student_id=s.id JOIN number_code_name cn ON s.current_grade=cn.code AND cn.category=''GRADE'' JOIN school csch ON s.current_school_id=csch.id JOIN school nsch ON (s.details->''transferDetails''->>''schoolId'')::UUID=nsch.id WHERE a.id=''{{applicationId}}'' AND EXISTS (SELECT 1 FROM users u WHERE id=(a.details->>''submittedBy'')::uuid AND u.user_type=''PUBLIC'')\\\"}\"}"
          }
        ],
