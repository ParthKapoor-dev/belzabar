      "serviceName": "db_service",
      "methodName": "data.update",
      "coreMethod": false,
      "description": "<ul id=\"isPasted\" style=\"margin-top:0;margin-bottom:0;padding-inline-start:48px;\"><li dir=\"ltr\" style=\"list-style-type:disc;font-size:11pt;font-family:Arial,sans-serif;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;\">Update status of any paused from long time iterations as FAILED.</li></ul>",
      "inputs": [
        {
          "uuid": "910cb0f4-1d44-4040-a708-0e35f747b82e",
          "key": "body",
          "name": "",
          "type": "OBJECT",
          "displayWidgetSuggestion": "OBJECT",
          "combineInput": false,
          "properties": [
            {
              "uuid": "aef549b2-fe20-4859-a697-11175062fd8e",
              "value": "UPDATE\n\tmatch_iteration \nSET status ='FAILED'\nWHERE ep_stage_id='#{epStageId}' \nAND status NOT IN ('ALGO_TRIGGER_FAIL', 'ALGO_FAILED','COMPLETED','FAILED')\nAND (EXTRACT(day from AGE(current_timestamp, executed_at))>1 \nOR (EXTRACT(day from AGE(current_timestamp, executed_at))=0 \nAND EXTRACT(hour from AGE(current_timestamp, executed_at)) > #{maxHourTimeAllowed}));",
              "key": "queryString",
              "name": "SQLQuery",
              "type": "STRING",
              "displayWidgetSuggestion": "CUSTOM",
