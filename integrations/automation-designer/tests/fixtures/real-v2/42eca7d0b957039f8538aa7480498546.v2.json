      "serviceName": "db_service",
      "methodName": "data.read",
      "coreMethod": false,
      "description": "<ul id=\"isPasted\" style=\"margin-top:0;margin-bottom:0;padding-inline-start:48px;\"><li dir=\"ltr\" style=\"list-style-type:disc;font-size:11pt;font-family:Arial,sans-serif;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;\">Fetch information whether there has been any iteration accepted for the epStageId or if any iteration is currently executing.</li></ul>",
      "inputs": [
        {
          "uuid": "8d49cef8-1a21-4214-9ebd-20e7174fec0c",
          "key": "body",
          "name": "",
          "type": "OBJECT",
          "displayWidgetSuggestion": "OBJECT",
          "combineInput": false,
          "properties": [
            {
              "uuid": "529f4d30-4692-46b3-b1fb-0fea77c68683",
              "value": "WITH st AS (\n    SELECT \n        status, \n        accepted \n    FROM \n        match_iteration \n    WHERE ep_stage_id = '#{epStageId}'\n)\nSELECT ep.id AS \"epId\",es.random_seed AS \"randomSeed\", ep.display_name AS \"epName\",es.round_no AS round,es.closed, CASE \n        WHEN es.closing_time <  NOW() AT TIME ZONE 'EST' THEN 'true' \n        ELSE 'false' \n    END AS \"closedPast\", es.stage_type_code AS \"stageType\",\n    (\n        EXISTS (\n            SELECT 1 \n            FROM st\n            WHERE accepted = true\n        )\n    ) AS \"matchAccepted\", \n    (\n        EXISTS (\n            SELECT 1 \n            FROM st \n            WHERE status NOT IN ('ALGO_TRIGGER_FAIL', 'ALGO_FAILED', 'COMPLETED','FAILED')\n        )\n    ) AS \"matchInProcess\"\nFROM enrollment_stage es , enrollment_process ep WHERE es.ep_id=ep.id AND es.id='#{epStageId}';\n",
              "key": "queryString",
              "name": "SQLQuery",
              "type": "STRING",
              "displayWidgetSuggestion": "CUSTOM",
              "combineInput": true,
              "properties": [],
              "encodingType": "NONE"
            },
            {
              "uuid": "476ea71abed20d6853a58dd1f0e06dca    ",
