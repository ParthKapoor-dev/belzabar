    {
      "id": "4c488ebe6dc69fe8f885805e30d8c5ca    ",
      "automationAPIId": "492a440d34d8550c14a2bb803c7e351b    ",
      "serviceName": "Schools-Utilities",
      "methodName": "replacePlaceholdersInText",
      "coreMethod": false,
      "inputs": [
        {
          "uuid": "444bebe5823e6370adc992d0a566d0b5    ",
          "value": "WITH logged_user AS( SELECT id FROM users where user_name = '#{LoggedInUser.Email}'   AND user_type=(CASE WHEN #{LoggedInUser.External} = true THEN 'PUBLIC' ELSE 'EXPERTLY' END::user_type)), #{subquery}, valid_recs AS ( SELECT DISTINCT all_docs.* FROM ( SELECT dcs.id, cds.doc_type_id, cds.code, unnest(cds.langs) AS lang FROM docs dcs JOIN codes cds ON dcs.code = cds.code ) AS all_docs JOIN data d ON all_docs.id = d.id AND ( all_docs.lang = 'EN' OR all_docs.lang = ANY(d.alternate_langs) ) ), del_docs AS ( UPDATE generated_document gd SET is_deleted = true, updated_by = lu.id, updated_at = now() FROM logged_user lu WHERE is_deleted = false AND EXISTS ( SELECT 1 FROM codes cd WHERE cd.doc_type_id = gd.doc_type_id ) AND EXISTS ( SELECT 1 FROM data d WHERE d.id = gd.{{tableKey}} ) AND NOT EXISTS ( SELECT 1 FROM valid_recs v WHERE v.doc_type_id = gd.doc_type_id AND v.lang = gd.language AND v.id = gd.{{tableKey}} ) ), reset_docs AS ( UPDATE generated_document gd SET is_deleted = false, updated_by = lu.id, updated_at = now() FROM logged_user lu, valid_recs v WHERE gd.{{tableKey}} = v.id AND gd.doc_type_id = v.doc_type_id AND gd.language = v.lang AND is_deleted = true RETURNING gd.{{tableKey}}, gd.doc_type_id, gd.language ) INSERT INTO generated_document ( id, {{tableKey}}, doc_type_id, language, is_being_generated, updated_by, updated_at ) ( SELECT gen_random_uuid(), v.id, v.doc_type_id, v.lang, false, lu.id, now() FROM logged_user lu, valid_recs AS v WHERE NOT EXISTS ( SELECT 1 FROM reset_docs upr WHERE upr.{{tableKey}} = v.id AND upr.doc_type_id = v.doc_type_id AND upr.language = v.lang ) AND NOT EXISTS ( SELECT 1 FROM generated_document g WHERE g.doc_type_id = v.doc_type_id AND language = v.lang AND g.{{tableKey}} = v.id ) ) ",
          "key": "text",
          "name": "text",
          "type": "STRING",
          "displayWidgetSuggestion": "CUSTOM",
