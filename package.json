{
  "name": "belzabar",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "integrations/*"
  ],
  "scripts": {
    "wi-impl:install": "bash ./apps/cli/scripts/install.sh",
    "wi-impl:reinstall": "bash ./apps/cli/scripts/reinstall.sh",
    "wi-impl:build": "bun run --cwd apps/cli build",
    "release": "bun scripts/release.ts",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs:check": "bun scripts/docs-check.ts",
    "check": "bun run typecheck && bun run docs:check && bun run dead-code && bun run test",
    "dead-code": "bun scripts/dead-code.ts --summary --check"
  },
  "devDependencies": {
    "@belzabar/core": "workspace:*",
    "@belzabar/migrations": "workspace:*",
    "@belzabar/teamwork": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "^5"
  }
}
