{
  "name": "belzabar",
  "private": true,
  "workspaces": [
    "cli",
    "cli/packages/*",
    "packages/*",
    "extension",
    "apps/*"
  ],
  "scripts": {
    "belz:install": "bash ./cli/scripts/install.sh",
    "belz:reinstall": "bash ./cli/scripts/reinstall.sh",
    "belz:build": "bun run --cwd cli build",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p cli/tsconfig.json",
    "check": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "turbo": "^2.8.3"
  }
}
