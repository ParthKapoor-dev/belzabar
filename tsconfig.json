{
  // `bun run typecheck` — every TypeScript workspace in one program.
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "integrations/**/*.ts",
    "apps/cli/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["**/node_modules"]
}
